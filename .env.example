# Keycloak / Google Social Auth Configuration
KEYCLOAK_URL="https://cloak.dev.personalclientcare.com/realms/peer-space"
KEYCLOAK_CLIENT_ID="peer-space"
KEYCLOAK_CLIENT_SECRET=""

# SESSION_SECRET: Signs the session token issued after a verified Keycloak login (used to
# trust isAdmin/email on the socket connection). Set this to a long random string in
# production - if left unset, a random secret is generated at boot and all sessions are
# invalidated on every restart/redeploy.
SESSION_SECRET=""
