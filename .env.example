# --- PeerSpace <-> Keycloak -------------------------------------------------------------
# All of these have working defaults for `docker compose up` on localhost, so for local
# development you can leave them commented out.
#
# Realm URL as the browser sees it (login redirect).
# KEYCLOAK_URL="http://localhost:8080/realms/peer-space"
# Realm URL as the PeerSpace server sees it (token exchange / userinfo). With the bundled
# Keycloak this is the Docker-internal hostname; with an external Keycloak set it to the
# same value as KEYCLOAK_URL.
# KEYCLOAK_INTERNAL_URL="http://keycloak:8080/realms/peer-space"
# KEYCLOAK_CLIENT_ID="peer-space"
# Change this for anything other than local development.
# KEYCLOAK_CLIENT_SECRET="peer-space-dev-secret"

# --- Bundled Keycloak (docker-compose.yml) ------------------------------------------------
# Public base URL of Keycloak (no /realms/... suffix). Tokens are issued for this URL.
# KEYCLOAK_PUBLIC_URL="http://localhost:8080"
# Public URL of PeerSpace - used for the client's redirect URI on the first realm import.
# PEERSPACE_URL="http://localhost:3000"
# Initial admin account for the Keycloak admin console (only applied on first start).
# KEYCLOAK_ADMIN_USER="admin"
# KEYCLOAK_ADMIN_PASSWORD="admin"
# KEYCLOAK_DB_PASSWORD="keycloak"
# Memory caps for the Keycloak JVM and its Postgres database.
# KEYCLOAK_MEM_LIMIT="512m"
# KEYCLOAK_DB_MEM_LIMIT="128m"
# JVM options for Keycloak; raise -Xmx together with KEYCLOAK_MEM_LIMIT for many users.
# KEYCLOAK_JAVA_HEAP="-Xms64m -Xmx256m -XX:MaxMetaspaceSize=192m -XX:ReservedCodeCacheSize=64m -Xss512k"
# KEYCLOAK_DB_POOL_MAX_SIZE="10"
# Host ports published by docker-compose.override.yml (local development only).
# PEERSPACE_PORT="3000"
# KEYCLOAK_PORT="8080"

# WebRTC ICE configuration (client-side, baked in at build time by Vite).
# Leaving all of these unset falls back to public Google STUN servers, which is fine for
# development and typical home networks but WILL fail behind symmetric NAT or a restrictive
# corporate firewall - those need a TURN relay. Configure one for production.
#
# Either supply the full RTCIceServer[] as JSON (replaces the defaults entirely):
# VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]'
#
# ...or use the shorthand, which appends a TURN entry to the default STUN servers:
# VITE_TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
# VITE_TURN_USERNAME=""
# VITE_TURN_CREDENTIAL=""

# SESSION_SECRET: Signs the session token issued after a verified Keycloak login (used to
# trust isAdmin/email on the socket connection). Set this to a long random string, in
# development as well as production.
#
# Note that an EMPTY value counts as unset - so leaving the line below as "" falls back to a
# secret randomly generated at boot. Every restart then invalidates every existing login,
# which shows up as admins mysteriously losing their privileges after a redeploy or a dev
# server reload. Generate one with:  openssl rand -hex 32
SESSION_SECRET=""
