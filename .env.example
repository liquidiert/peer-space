# --- Google sign-in ---------------------------------------------------------------------
# Sign-in uses Google OpenID Connect directly. Create an OAuth client ID of type
# "Web application" in Google Cloud Console (APIs & Services > Credentials) and add the
# redirect URI https://<your-domain>/auth/callback (and http://localhost:3000/auth/callback
# for local development). Without the client ID and secret, sign-in returns 503.
# Any Google account can sign in. Access to individual spaces is still controlled by membership.
# GOOGLE_CLIENT_ID="123456789-abc.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."
# Comma separated emails that are always admins. They cannot be removed in the app.
# Other admins can be granted and revoked in the app by an admin.
# ADMIN_EMAILS="you@example.com,colleague@example.com"
# Public origin of PeerSpace, e.g. https://space.example.com. Used to build the redirect URI
# (<PUBLIC_URL>/auth/callback). Leave it unset behind a reverse proxy that sets
# X-Forwarded-Proto and X-Forwarded-Host.
# PUBLIC_URL="http://localhost:3000"

# Host port published by docker-compose.override.yml (local development only).
# PEERSPACE_PORT="3000"
# WebRTC ICE configuration (client-side, baked in at build time by Vite).
# Leaving all of these unset falls back to public Google STUN servers, which is fine for
# development and typical home networks but WILL fail behind symmetric NAT or a restrictive
# corporate firewall - those need a TURN relay. Configure one for production.
#
# Either supply the full RTCIceServer[] as JSON (replaces the defaults entirely):
# VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]'
#
# ...or use the shorthand, which appends a TURN entry to the default STUN servers:
# VITE_TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
# VITE_TURN_USERNAME=""
# VITE_TURN_CREDENTIAL=""

# SESSION_SECRET: Signs session tokens and encrypts the login-state cookie used during
# Google sign-in. Set this to a long random string, in development as well as production.
#
# Note that an EMPTY value counts as unset - so leaving the line below as "" falls back to a
# secret randomly generated at boot. Every restart then invalidates every existing login,
# which shows up as admins mysteriously losing their privileges after a redeploy or a dev
# server reload. Generate one with:  openssl rand -hex 32
SESSION_SECRET=""
