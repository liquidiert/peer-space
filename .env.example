# Keycloak / Google Social Auth Configuration
KEYCLOAK_URL="https://cloak.dev.personalclientcare.com/realms/peer-space"
KEYCLOAK_CLIENT_ID="peer-space"
KEYCLOAK_CLIENT_SECRET=""

# WebRTC ICE configuration (client-side, baked in at build time by Vite).
# Leaving all of these unset falls back to public Google STUN servers, which is fine for
# development and typical home networks but WILL fail behind symmetric NAT or a restrictive
# corporate firewall - those need a TURN relay. Configure one for production.
#
# Either supply the full RTCIceServer[] as JSON (replaces the defaults entirely):
# VITE_ICE_SERVERS='[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]'
#
# ...or use the shorthand, which appends a TURN entry to the default STUN servers:
# VITE_TURN_URLS="turn:turn.example.com:3478,turns:turn.example.com:5349"
# VITE_TURN_USERNAME=""
# VITE_TURN_CREDENTIAL=""

# SESSION_SECRET: Signs the session token issued after a verified Keycloak login (used to
# trust isAdmin/email on the socket connection). Set this to a long random string, in
# development as well as production.
#
# Note that an EMPTY value counts as unset - so leaving the line below as "" falls back to a
# secret randomly generated at boot. Every restart then invalidates every existing login,
# which shows up as admins mysteriously losing their privileges after a redeploy or a dev
# server reload. Generate one with:  openssl rand -hex 32
SESSION_SECRET=""
